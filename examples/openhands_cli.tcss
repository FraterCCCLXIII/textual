Screen {
    background: #000000;
    color: #f2f2f2;
    scrollbar-background: #0b0b0b;
    scrollbar-background-hover: #141414;
    scrollbar-background-active: #1d1d1d;
    scrollbar-color: #6f6f6f;
    scrollbar-color-hover: #8a8a8a;
    scrollbar-color-active: #b0b0b0;
    scrollbar-corner-color: #0b0b0b;
}

VerticalScroll,
OptionList,
#threads,
#chat-view,
#slash-menu,
#slash-submenu,
#approval-options {
    scrollbar-background: #0b0b0b;
    scrollbar-background-hover: #141414;
    scrollbar-background-active: #1d1d1d;
    scrollbar-color: #6f6f6f;
    scrollbar-color-hover: #8a8a8a;
    scrollbar-color-active: #b0b0b0;
    scrollbar-corner-color: #0b0b0b;
}

OptionList {
    background: #000000;
    color: #f2f2f2;
    border: round #8a8a8a;
}

OptionList:hover {
    border: round #a0a0a0;
}

OptionList:focus {
    border: round #b0b0b0;
}

OptionList > .option-list--option-hover {
    background: #181818;
    color: #f2f2f2;
}

OptionList > .option-list--option-highlighted {
    background: #2a2a2a;
    color: white;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    background: #3a3a3a;
    color: white;
}

#startup-shell {
    width: 1fr;
    height: 1fr;
    align: center top;
    layout: vertical;
    padding: 2 4;
    background: #000000;
}

#startup-logo {
    width: auto;
    color: #f2f2f2;
    text-style: bold;
    margin-bottom: 0;
}

#startup-version {
    color: #f2f2f2;
    margin-bottom: 1;
}

#startup-pill {
    width: auto;
    border: round #8a8a8a;
    color: #f2f2f2;
    background: #0f0f0f;
    padding: 0 1;
    margin-bottom: 1;
}

#onboarding-main-card {
    width: 96;
    max-width: 95%;
    border: round #8a8a8a;
    background: #000000;
    color: #d0d0d0;
    padding: 1 2;
    margin-bottom: 1;
}

#onboarding-choice-card {
    display: none;
    width: 40;
    border: solid #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 1 2;
    margin-bottom: 1;
}

#onboarding-choice-card.-visible {
    display: block;
}

#startup-call-to-action {
    color: #d6d6d6;
}

#main-shell {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    padding: 0;
}

/* Conversation tabs at top - black background, thin grey/white underlines */
#conversation-tabs {
    dock: top;
    height: 3;
    background: #000000;
}

#conversation-tabs Tab {
    color: #a0a0a8;
}

#conversation-tabs Tab:hover {
    color: #d0d0d8;
}

#conversation-tabs Tab.-active {
    color: #e0e0e8;
}

#conversation-tabs Underline {
    height: 1;
}

#conversation-tabs .underline--bar {
    background: #6a6a70;
    color: white;
}

#onboarding-banner {
    display: none;
    height: auto;
    border-bottom: solid #555555;
    color: #f2f2f2;
    background: #0a0a0a;
    padding: 0 1;
}

#onboarding-banner.-visible {
    display: block;
}

#status-footer {
    height: 1;
    width: 1fr;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
    align: left middle;
}

#status-left {
    width: auto;
    color: #f2f2f2;
}

#model-label {
    width: auto;
    color: #f2f2f2;
    text-style: bold;
    margin-right: 0;
}

#model-shortcut {
    width: auto;
    color: #8a8a8a;
    margin-right: 0;
}

#cloud-label {
    width: auto;
    color: #f2f2f2;
    margin-right: 0;
}

#cloud-picker {
    width: auto;
    min-width: 8;
    border: none;
    background: transparent;
    color: #f2f2f2;
    margin-left: 1;
    height: 1;
}

#cloud-picker > SelectCurrent {
    width: auto;
    min-width: 8;
    height: 1;
    border: none !important;
    background: transparent;
    background-tint: 0%;
    padding: 0;
}

#cloud-picker > SelectCurrent Static#label {
    width: auto;
}

#cloud-picker > SelectCurrent .arrow {
    width: auto;
    padding: 0 0 0 1;
}

#cloud-picker > SelectOverlay {
    width: auto;
    min-width: 22;
    padding: 0;
    constrain: none inflect;
}

#cloud-picker:hover {
    background: transparent;
    color: #f2f2f2;
}

#cloud-picker:focus {
    border: none;
    background: transparent;
    color: #f2f2f2;
}

#cloud-picker:focus > SelectCurrent,
#cloud-picker.-expanded > SelectCurrent {
    border: none !important;
    background: transparent;
    background-tint: 0%;
}

#model-picker {
    width: auto;
    min-width: 9;
    border: none;
    background: transparent;
    color: #f2f2f2;
    text-style: bold;
    margin: 0;
    height: 1;
}

#model-picker > SelectCurrent {
    width: auto;
    min-width: 9;
    height: 1;
    border: none !important;
    background: transparent;
    background-tint: 0%;
    padding: 0;
}

#model-picker > SelectCurrent Static#label {
    width: auto;
}

#model-picker > SelectCurrent .arrow {
    width: auto;
    padding: 0 0 0 1;
}

#model-picker > SelectOverlay {
    width: auto;
    min-width: 24;
    constrain: none inflect;
}

#model-picker:hover {
    background: transparent;
    color: #f2f2f2;
}

#model-picker:focus {
    border: none;
    background: transparent;
    color: #f2f2f2;
}

#model-picker:focus > SelectCurrent {
    border: none !important;
    background: transparent;
    background-tint: 0%;
}

#model-picker.-expanded > SelectCurrent {
    border: none !important;
    background: transparent;
    background-tint: 0%;
}

#workspace {
    height: 1fr;
    width: 1fr;
    padding: 0 1;
}

#workspace-columns {
    width: 1fr;
    height: 1fr;
}

#thread-panel {
    width: 30;
    min-width: 24;
    max-width: 38;
    border-right: solid #555555;
    background: #000000;
    padding: 0 2 0 0;
}

#chat-panel {
    width: 1fr;
    padding: 0 0 0 1;
}

#fly-view {
    display: none;
    width: 1fr;
    height: 1fr;
    margin: 0;
    border: round #8a8a8a;
    background: #000000;
    color: #d6d6d6;
    padding: 0;
}

#fly-view.-visible {
    display: block;
}

#board-view {
    display: none;
    width: 1fr;
    height: 1fr;
    padding: 1 0 0 0;
}

#board-view.-visible {
    display: block;
}

#board-columns {
    width: 1fr;
    height: 1fr;
}

.board-column {
    width: 1fr;
    height: 1fr;
    border: round #7a7a7a;
    background: #050505;
    margin-right: 1;
}

.board-column-title {
    height: auto;
    border-bottom: solid #3a3a3a;
    color: #d9d9d9;
    text-style: bold;
    content-align: center middle;
    padding: 0 1;
}

.board-list {
    height: 1fr;
    border: none;
    background: #050505;
    color: #f2f2f2;
    padding: 0;
}

.board-list > .option-list--option {
    border-bottom: solid #2a2a2a;
    padding: 0 1;
}

.panel-title {
    color: #c0c0c0;
    margin: 0;
    padding: 0 1;
    text-style: bold;
}

#threads {
    height: 1fr;
    border: none;
    background: #000000;
}

#threads > .option-list--option {
    border-bottom: solid #2a2a2a;
    padding: 1 1 1 0;
}

#threads > .option-list--option-hover,
#approval-options > .option-list--option-hover,
#slash-menu > .option-list--option-hover,
#slash-submenu > .option-list--option-hover,
#board-open-list > .option-list--option-hover,
#board-review-list > .option-list--option-hover,
#board-merged-list > .option-list--option-hover {
    background: #181818;
    color: #f2f2f2;
}

#threads > .option-list--option-highlighted,
#approval-options > .option-list--option-highlighted,
#slash-menu > .option-list--option-highlighted,
#slash-submenu > .option-list--option-highlighted,
#board-open-list > .option-list--option-highlighted,
#board-review-list > .option-list--option-highlighted,
#board-merged-list > .option-list--option-highlighted {
    background: #2a2a2a;
    color: white;
    text-style: bold;
}

#threads:focus > .option-list--option-highlighted,
#approval-options:focus > .option-list--option-highlighted,
#slash-menu:focus > .option-list--option-highlighted,
#slash-submenu:focus > .option-list--option-highlighted,
#board-open-list:focus > .option-list--option-highlighted,
#board-review-list:focus > .option-list--option-highlighted,
#board-merged-list:focus > .option-list--option-highlighted {
    background: #3a3a3a;
    color: white;
}

#chat-view {
    height: 1fr;
    border: none;
    background: #000000;
    padding: 0;
}

.chat-line {
    margin: 0;
    padding: 0;
}

.assistant {
    color: #f2f2f2;
}

.user {
    color: #f2f2f2;
}

#chat-input {
    margin: 0 1 0 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
}

#chat-input:hover {
    border: round #a0a0a0;
    background: #050505;
}

#chat-input:focus {
    border: round #c8c8c8;
    background: #050505;
    color: white;
}

#tips-drawer {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
}

#tips-drawer.-visible {
    display: block;
}

#approval-title {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    border-bottom: none;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
    text-style: bold;
}

#approval-title.-visible {
    display: block;
}

#approval-options {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 0;
}

#approval-options:hover,
#slash-menu:hover,
#slash-submenu:hover {
    border: round #a0a0a0;
}

#approval-options.-visible {
    display: block;
}

#slash-menu {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
    text-style: bold;
}

#slash-menu.-visible {
    display: block;
}

#slash-submenu-title {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    border-bottom: none;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
    text-style: bold;
}

#slash-submenu-title.-visible {
    display: block;
}

#slash-submenu {
    display: none;
    margin: 0 1 1 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 0;
}

#slash-submenu.-visible {
    display: block;
}

Footer {
    background: #000000;
}

/* Modal dialog shown via /modal command */
ModalDialogScreen {
    align: center middle;
}

#modal-dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 2 3;
    width: 50;
    height: 12;
    border: round white;
    background: #1a1a1a;
}

#modal-title {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
    text-style: bold;
}

#modal-dialog Button {
    width: 100%;
    border: round white;
    background: transparent !important;
    color: white;
}

#modal-dialog Button:hover {
    background: transparent !important;
}

#modal-dialog Button:focus {
    background: transparent !important;
}

CloudConnectModalScreen {
    align: center middle;
}

#cloud-connect-modal {
    width: auto;
    height: auto;
    max-width: 90%;
    border: round #8a8a8a;
    padding: 1 2;
}

#cloud-connect-title {
    width: auto;
    text-style: bold;
    content-align: center middle;
    padding: 1 0;
    margin-bottom: 1;
}

#cloud-connect-body {
    width: auto;
    content-align: center middle;
    margin-top: 1;
}

#cloud-connect-link {
    width: auto;
    border: round #8a8a8a;
    content-align: center middle;
    padding: 1 2;
    margin: 1 0;
    text-style: bold;
}

#cloud-connect-waiting {
    width: auto;
    content-align: center middle;
    margin-bottom: 1;
}

#cloud-connect-cancel {
    width: 16;
    align-horizontal: center;
    border: round #8a8a8a;
    background: transparent !important;
}

#cloud-connect-cancel:hover,
#cloud-connect-cancel:focus {
    background: transparent !important;
}

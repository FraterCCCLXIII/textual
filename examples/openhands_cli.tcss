Screen {
    background: $surface;
    color: $text;
}

#startup-shell {
    width: 1fr;
    height: 1fr;
    align: center top;
    layout: vertical;
    padding: 2 4;
    background: $surface;
}

#startup-logo {
    width: auto;
    color: $warning;
    text-style: bold;
    margin-bottom: 0;
}

#startup-version {
    color: $text;
    margin-bottom: 1;
}

#startup-pill {
    width: auto;
    border: round $panel;
    color: $text;
    background: $surface-lighten-1;
    padding: 0 1;
    margin-bottom: 1;
}

#onboarding-main-card {
    width: 96;
    max-width: 98%;
    max-width: 95%;
    border: tall $panel;
    background: $surface;
    color: $text-muted;
    padding: 1 2;
    margin-bottom: 1;
}

#onboarding-choice-card {
    display: none;
    width: 40;
    border: round $panel;
    background: $surface;
    color: $text;
    padding: 1 2;
    margin-bottom: 1;
}

#onboarding-choice-card.-visible {
    display: block;
}

#startup-call-to-action {
    color: $success;
}

#main-shell {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#onboarding-banner {
    display: none;
    height: auto;
    border-bottom: solid $panel;
    color: $primary-lighten-2;
    background: $surface-lighten-1;
    padding: 0 1;
}

#onboarding-banner.-visible {
    display: block;
}

#status-line {
    height: auto;
    border-bottom: solid $panel;
    background: $surface-lighten-1;
    color: $text;
    padding: 0 1;
}

#workspace {
    height: 1fr;
    width: 1fr;
}

#thread-panel {
    width: 34;
    min-width: 28;
    max-width: 44;
    border-right: heavy $panel;
    background: $surface-darken-1;
    padding: 0 1;
}

#chat-panel {
    width: 1fr;
    padding: 0 1;
}

.panel-title {
    color: $text-muted;
    margin-top: 1;
    margin-bottom: 1;
    text-style: bold;
}

#threads {
    height: 1fr;
    border: tall $panel;
    background: $surface;
}

#chat-view {
    height: 1fr;
    border: tall $panel;
    background: $surface;
    padding: 0 1;
}

#todo-list-card {
    height: auto;
    border: round $panel;
    background: $surface-lighten-1;
    color: $text;
    padding: 1 2;
    margin-bottom: 1;
}

#cost-feed-card {
    height: auto;
    border: round $panel;
    background: $surface;
    color: $text;
    padding: 0 2;
    margin-bottom: 1;
}

.chat-line {
    margin: 1 0;
    padding: 0;
}

.assistant {
    color: $text;
}

.user {
    color: $text;
}

#chat-input {
    margin: 1;
    border: round $accent;
    background: $surface-lighten-1;
    color: $text;
}

#tips-drawer {
    display: none;
    margin: 0 1 0 1;
    border: round $panel;
    background: $surface;
    color: $text;
    padding: 1 2;
}

#tips-drawer.-visible {
    display: block;
}

#approval-title {
    display: none;
    margin: 1 1 0 1;
    border: round $panel;
    border-bottom: none;
    background: $surface;
    color: $text;
    padding: 0 2;
    text-style: bold;
}

#approval-title.-visible {
    display: block;
}

#approval-options {
    display: none;
    margin: 0 1 1 1;
    border: round $panel;
    background: $surface;
    color: $text;
    padding: 0 1;
}

#approval-options.-visible {
    display: block;
}

#slash-menu {
    display: none;
    margin: 0 1 1 1;
    border: round $panel;
    background: $surface-lighten-1;
    color: $text;
    padding: 1 2;
    text-style: bold;
}

#slash-menu.-visible {
    display: block;
}

Footer {
    background: $surface-darken-1;
}

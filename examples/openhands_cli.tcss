Screen {
    background: #000000;
    color: #f2f2f2;
    scrollbar-background: #0b0b0b;
    scrollbar-background-hover: #141414;
    scrollbar-background-active: #1d1d1d;
    scrollbar-color: #6f6f6f;
    scrollbar-color-hover: #8a8a8a;
    scrollbar-color-active: #b0b0b0;
    scrollbar-corner-color: #0b0b0b;
}

VerticalScroll,
OptionList,
#threads,
#chat-view,
#slash-menu,
#slash-submenu,
#approval-options {
    scrollbar-background: #0b0b0b;
    scrollbar-background-hover: #141414;
    scrollbar-background-active: #1d1d1d;
    scrollbar-color: #6f6f6f;
    scrollbar-color-hover: #8a8a8a;
    scrollbar-color-active: #b0b0b0;
    scrollbar-corner-color: #0b0b0b;
}

OptionList {
    background: #000000;
    color: #f2f2f2;
    border: round #8a8a8a;
}

OptionList:hover {
    border: round #a0a0a0;
}

OptionList:focus {
    border: round #b0b0b0;
}

OptionList > .option-list--option-hover {
    background: #181818;
    color: #f2f2f2;
}

OptionList > .option-list--option-highlighted {
    background: #2a2a2a;
    color: white;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    background: #3a3a3a;
    color: white;
}

#startup-shell {
    width: 1fr;
    height: 1fr;
    align: center top;
    layout: vertical;
    padding: 2 4;
    background: #000000;
}

#startup-logo {
    width: auto;
    color: #f2f2f2;
    text-style: bold;
    margin-bottom: 0;
}

#startup-version {
    color: #f2f2f2;
    margin-bottom: 1;
}

#startup-pill {
    width: auto;
    border: round #8a8a8a;
    color: #f2f2f2;
    background: #0f0f0f;
    padding: 0 1;
    margin-bottom: 1;
}

#onboarding-main-card {
    width: 96;
    max-width: 95%;
    border: round #8a8a8a;
    background: #000000;
    color: #d0d0d0;
    padding: 1 2;
    margin-bottom: 1;
}

#onboarding-choice-card {
    display: none;
    width: 40;
    border: solid #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 1 2;
    margin-bottom: 1;
}

#onboarding-choice-card.-visible {
    display: block;
}

#startup-call-to-action {
    color: #d6d6d6;
}

#main-shell {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    padding: 0;
}

#onboarding-banner {
    display: none;
    height: auto;
    border-bottom: solid #555555;
    color: #f2f2f2;
    background: #0a0a0a;
    padding: 0 1;
}

#onboarding-banner.-visible {
    display: block;
}

#status-line {
    height: auto;
    border-bottom: solid #555555;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
}

#workspace {
    height: 1fr;
    width: 1fr;
    padding: 0 1;
}

#thread-panel {
    width: 30;
    min-width: 24;
    max-width: 38;
    border-right: solid #555555;
    background: #000000;
    padding: 0 2 0 0;
}

#chat-panel {
    width: 1fr;
    padding: 0 0 0 1;
}

#code-city-view {
    display: none;
    height: auto;
    margin: 0 1 1 1;
    border: round #8a8a8a;
    background: #000000;
    color: #d6d6d6;
    padding: 0 1;
}

#code-city-view.-visible {
    display: block;
}

.panel-title {
    color: #c0c0c0;
    margin: 0;
    padding: 0 1;
    text-style: bold;
}

#threads {
    height: 1fr;
    border: none;
    background: #000000;
}

#threads > .option-list--option {
    border-bottom: solid #2a2a2a;
    padding-right: 1;
    margin-bottom: 1;
}

#threads > .option-list--option-hover,
#approval-options > .option-list--option-hover,
#slash-menu > .option-list--option-hover,
#slash-submenu > .option-list--option-hover {
    background: #181818;
    color: #f2f2f2;
}

#threads > .option-list--option-highlighted,
#approval-options > .option-list--option-highlighted,
#slash-menu > .option-list--option-highlighted,
#slash-submenu > .option-list--option-highlighted {
    background: #2a2a2a;
    color: white;
    text-style: bold;
}

#threads:focus > .option-list--option-highlighted,
#approval-options:focus > .option-list--option-highlighted,
#slash-menu:focus > .option-list--option-highlighted,
#slash-submenu:focus > .option-list--option-highlighted {
    background: #3a3a3a;
    color: white;
}

#chat-view {
    height: 1fr;
    border: none;
    background: #000000;
    padding: 0;
}

.chat-line {
    margin: 0;
    padding: 0;
}

.assistant {
    color: #f2f2f2;
}

.user {
    color: #f2f2f2;
}

#chat-input {
    margin: 0 1 1 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
}

#chat-input:hover {
    border: round #a0a0a0;
    background: #050505;
}

#chat-input:focus {
    border: round #c8c8c8;
    background: #050505;
    color: white;
}

#tips-drawer {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
}

#tips-drawer.-visible {
    display: block;
}

#approval-title {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    border-bottom: none;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
    text-style: bold;
}

#approval-title.-visible {
    display: block;
}

#approval-options {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 0;
}

#approval-options:hover,
#slash-menu:hover,
#slash-submenu:hover {
    border: round #a0a0a0;
}

#approval-options.-visible {
    display: block;
}

#slash-menu {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
    text-style: bold;
}

#slash-menu.-visible {
    display: block;
}

#slash-submenu-title {
    display: none;
    margin: 0 1;
    border: round #8a8a8a;
    border-bottom: none;
    background: #000000;
    color: #f2f2f2;
    padding: 0 1;
    text-style: bold;
}

#slash-submenu-title.-visible {
    display: block;
}

#slash-submenu {
    display: none;
    margin: 0 1 1 1;
    border: round #8a8a8a;
    background: #000000;
    color: #f2f2f2;
    padding: 0;
}

#slash-submenu.-visible {
    display: block;
}

Footer {
    background: #000000;
}

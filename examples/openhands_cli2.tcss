Screen {
    background: #000000;
    color: #ffffff;
}

Button,
Input,
OptionList,
#dashboard-summary,
#login-note {
    border: round #ffffff;
}

Button {
    background: #000000;
    color: #ffffff;
    text-style: bold;
    padding: 0 1;
    margin-right: 1;
}

Button:hover {
    background: #111111;
}

Button.-active {
    background: #ffffff;
    color: #000000;
}

Input {
    background: #000000;
    color: #ffffff;
    margin-top: 1;
    padding: 0 1;
}

Input:focus {
    border: round #d7d7d7;
}

OptionList {
    background: #000000;
    color: #ffffff;
    margin-top: 1;
}

OptionList > .option-list--option-highlighted {
    background: #ffffff;
    color: #000000;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: #141414;
}

.section-title {
    text-style: bold;
    color: #ffffff;
}

.panel {
    border: round #ffffff;
    background: #000000;
    padding: 1;
}

.panel-title {
    color: #ffffff;
    text-style: bold;
}

/* Login */
#login-shell {
    width: 1fr;
    height: 1fr;
    align: center middle;
}

#login-card {
    width: 72;
    max-width: 90%;
    height: auto;
    border: round #ffffff;
    background: #000000;
    padding: 2 3;
}

#login-title {
    text-style: bold;
    color: #ffffff;
}

#login-subtitle {
    color: #d9d9d9;
    margin-bottom: 1;
}

#login-actions {
    margin-top: 1;
    height: auto;
}

#login-note {
    margin-top: 1;
    color: #cfcfcf;
    padding: 0 1;
}

/* Dashboard */
#dashboard-shell {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    layout: vertical;
}

#dashboard-hero {
    border: round #ffffff;
    background: #000000;
    padding: 1 2;
    margin-bottom: 1;
}

#dashboard-subtitle {
    color: #cfcfcf;
}

#dashboard-actions {
    margin-top: 1;
    height: auto;
}

#dashboard-grid {
    width: 1fr;
    height: 1fr;
}

#dashboard-conversations-panel {
    width: 1fr;
    margin-right: 1;
}

#dashboard-summary-panel {
    width: 1fr;
}

#dashboard-summary {
    height: 1fr;
    margin-top: 1;
    padding: 1 2;
    color: #ffffff;
}

/* Workspace */
#workspace-shell {
    width: 1fr;
    height: 1fr;
    padding: 1;
    layout: vertical;
}

#workspace-header {
    border: none;
    border-bottom: solid #ffffff;
    padding: 0;
    height: auto;
    margin-bottom: 1;
}

#workspace-title {
    width: 1fr;
    text-style: bold;
    color: #ffffff;
}

#workspace-top-tabs {
    width: auto;
    height: auto;
    align: right middle;
}

.top-nav-tab {
    border: none;
    background: #000000;
    color: #9a9a9a;
    text-style: none;
    padding: 0 1;
    margin-right: 1;
}

.top-nav-tab:hover {
    background: #000000;
    color: #ffffff;
}

.top-nav-tab.-active {
    border: none;
    border-bottom: solid #32d74b;
    background: #000000;
    color: #ffffff;
    text-style: bold;
}

#workspace-columns {
    width: 1fr;
    height: 1fr;
}

/* Remove panel boxes in new conversation workspace */
#workspace-columns .panel {
    border: none;
    padding: 0 1;
}

#conversations-pane {
    width: 32;
    min-width: 24;
    padding: 0 0 0 1;
}

#chat-pane {
    width: 56;
    min-width: 40;
}

#canvas-pane {
    width: 1fr;
    min-width: 36;
}

.panel-head {
    height: auto;
    align: left middle;
    width: 1fr;
}

#conversations-head-title {
    width: 1fr;
}

#workspace-hide-conversations {
    border: none;
    background: #000000;
    padding: 0;
    margin-left: 0;
    margin-right: 0;
    width: auto;
}

#workspace-hide-conversations:hover {
    background: #000000;
    color: #cfcfcf;
}

#workspace-conversations {
    height: 1fr;
    margin-top: 1;
    border: none;
}

#workspace-conversations > .option-list--option {
    border-bottom: solid #5a5a5a;
    padding-top: 1;
    padding-bottom: 1;
    margin-bottom: 2;
}

#workspace-conversations > .option-list--option-highlighted,
#workspace-conversations > .option-list--option-hover {
    border-bottom: solid #5a5a5a;
    padding-top: 1;
    padding-bottom: 1;
    margin-bottom: 2;
}

#chat-scroll {
    height: 1fr;
    margin-top: 1;
    border: none;
    background: #000000;
    padding: 0;
}

#chat-composer {
    height: auto;
    margin-top: 1;
}

#chat-input {
    width: 1fr;
    margin-top: 0;
    margin-right: 1;
}

.chat-bubble {
    width: 1fr;
    margin-bottom: 1;
    padding: 0 1;
    border: none;
}

.chat-bubble-assistant {
    background: #000000;
    color: #ffffff;
}

.chat-bubble-user {
    background: #2a2a2a;
    color: #ffffff;
}

#canvas-tabs {
    height: auto;
    margin-top: 1;
}

.canvas-tab {
    margin-right: 1;
}

#canvas-content {
    height: 1fr;
    margin-top: 1;
    padding: 0 1;
    color: #ffffff;
    background: #000000;
    border: none;
}

/* Single-line separators between panes */
#splitter-left,
#splitter-right {
    width: 1;
    min-width: 1;
    height: 1fr;
    background: #000000;
    color: #6a6a6a;
    margin: 0;
}

#splitter-left:hover,
#splitter-right:hover,
#splitter-left.-dragging,
#splitter-right.-dragging {
    color: #ffffff;
}

/* CLI2 provider login */
#cli2-login-shell {
    width: 1fr;
    height: 1fr;
    align: center middle;
}

#cli2-login-card {
    width: 56;
    max-width: 90%;
    height: auto;
    align: center middle;
    layout: vertical;
}

#cli2-login-mark {
    width: 1fr;
    content-align: center middle;
    margin-bottom: 1;
    color: #e5e5e5;
}

#cli2-login-title {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
    color: #f2f2f2;
    margin-bottom: 1;
}

.oauth-btn {
    width: 1fr;
    margin-right: 0;
    margin-bottom: 1;
    background: #000000;
    text-style: bold;
}

#cli2-login-github {
    border: round #b045d6;
    color: #dca8ef;
}

#cli2-login-gitlab {
    border: round #ff6b1a;
    color: #ffb58f;
}

#cli2-login-bitbucket {
    border: round #3b82f6;
    color: #a7c8ff;
}

#cli2-login-github:hover {
    background: #170a1d;
}

#cli2-login-gitlab:hover {
    background: #201006;
}

#cli2-login-bitbucket:hover {
    background: #091223;
}

#cli2-login-legal {
    width: 1fr;
    content-align: center middle;
    color: #9a9a9a;
    margin-top: 2;
}
